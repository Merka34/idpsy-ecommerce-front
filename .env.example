# Frontend Environment Variables
# Copia este archivo a .env.local y rellena los valores

# Google OAuth 2.0 Configuration
# 1. Ve a https://console.cloud.google.com/
# 2. Crea un nuevo proyecto
# 3. Habilita la API de Google Identity
# 4. Crea credenciales OAuth 2.0 para aplicaciones web
# 5. Añade estas URLs autorizadas:
#    - http://localhost:5173
#    - http://localhost:3000
#    - tu-dominio.com
# 6. Copia el Client ID aquí:
VITE_GOOGLE_CLIENT_ID=786423240592-70pjrrdj6q7tl4k3h54h77t4gn1gfi0a.apps.googleusercontent.com

# API URL (si es diferente a /api)
VITE_API_URL=http://localhost:3001
